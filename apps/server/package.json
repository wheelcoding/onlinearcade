{
  "name": "@onlinearcade/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:socket.io --outfile=dist/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@onlinearcade/core": "*",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.0"
  }
}
