# For Next.js, copy frontend settings to apps/web/.env.local
NEXT_PUBLIC_MULTIPLAYER_URL=http://localhost:3001
# Export these in the server environment
WEB_ORIGIN=http://localhost:3000
PORT=3001
# Set true only behind a trusted reverse proxy such as the Render deployment
TRUST_PROXY=false
# Public Supabase frontend configuration (never use a secret/service_role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
